# Coordinator listen address
PROTEUS_HTTP_ADDR=0.0.0.0:8080

# App database (coordinator and, via component URLs, Python services)
PROTEUS_DATABASE_URL=postgres://proteus:proteus@127.0.0.1:5432/proteus
PROTEUS_COMPONENT_DATABASE_URL=postgres://proteus:proteus@postgres:5432/proteus

# Cache
PROTEUS_REDIS_URL=redis://127.0.0.1:6379/0
PROTEUS_COMPONENT_REDIS_URL=redis://redis:6379/0

# Temporal
PROTEUS_TEMPORAL_ADDRESS=127.0.0.1:7233
PROTEUS_COMPONENT_TEMPORAL_ADDRESS=temporal:7233
PROTEUS_TEMPORAL_NAMESPACE=default
PROTEUS_TEMPORAL_UI_URL=http://127.0.0.1:8233

# Execution runtime. docker is implemented. kubernetes is a seam only.
PROTEUS_RUNTIME=docker
PROTEUS_DOCKER_BIN=docker
PROTEUS_DOCKER_NETWORK=proteus
PROTEUS_BASE_IMAGE=proteus-python-base:latest
PROTEUS_PUBLIC_HOST=127.0.0.1

# Paths. Relative paths are resolved from the process working directory.
PROTEUS_ROOT=.
PROTEUS_COMPONENTS_DIR=components
PROTEUS_PYTHON_DIR=python
PROTEUS_SCHEMA_PATH=deploy/schema.sql

# Which component owns "/".
PROTEUS_BOOTSTRAP_COMPONENT=bootstrap

# Herdr / OpenCode. The mutator defaults to grok 4.7.
PROTEUS_AGENT_BACKEND=herdr
PROTEUS_AGENT_KIND=opencode
PROTEUS_MODEL=xai/grok-4.7
PROTEUS_HERDR_BIN=herdr
PROTEUS_AGENT_NAME=proteus-mutator
# Recheck interval while an agent is working. A working agent is not failed when this elapses.
PROTEUS_AGENT_TIMEOUT_MS=60000
# herdr calls OpenCode. echo returns the prompt and is for tests.
PROTEUS_ABILITY_EXECUTOR=herdr
